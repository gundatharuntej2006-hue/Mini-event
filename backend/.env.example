# EVENT HQ Backend Environment Configuration (Template)
# Copy this file to .env and configure all variables securely before launching.

# Environment Mode: development | testing | production
ENVIRONMENT=development

# Database Connection URL (PostgreSQL in production, SQLite in local testing)
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/event_hq

# Mandatory Secret Key for JWT Signing (Minimum 32 random characters)
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_MIN_32_CHARACTERS

# JWT Token Expiry (in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Tournament Defaults
EVENT_NAME=EVENT HQ · BMSIT 2026
DEFAULT_TABLE_COUNT=32

# Initial Organizer Account Setup (Optional - Leave blank to create via CLI: python cli.py create-user)
INITIAL_ORGANIZER_EMAIL=organizer@bmsit.in
INITIAL_ORGANIZER_PASSWORD=CHANGE_THIS_ORGANIZER_INITIAL_PASSWORD
INITIAL_ORGANIZER_NAME=Lead Organizer